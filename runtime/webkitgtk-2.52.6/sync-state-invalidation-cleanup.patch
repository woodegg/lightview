+void Connection::SyncMessageState::removeConnection(Connection& connection)
+{
+    assertIsCurrent(m_dispatcher.get());
+    connection.m_incomingMessagesLock.assertIsOwner();
+    Locker locker { m_lock };
+    m_didScheduleDispatchMessagesWorkSet.remove(&connection);
+    m_allMessagesShouldBeDispatchedWhileWaitingForSyncReplySet.remove(&connection);
+    auto matchesConnection = [&](auto& message) { return message.connection.ptr() == &connection; };
+    m_messagesBeingDispatched.removeAllMatching(matchesConnection);
+    m_messagesToDispatchWhileWaitingForSyncReply.removeAllMatching(matchesConnection);
+}
