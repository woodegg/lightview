@@ -1772,6 +1786,36 @@
   if (G_UNLIKELY (ret != GST_FLOW_OK))
     goto alloc_failed;
 
+  info = &ffmpegdec->output_state->info;
+  /* This is a freshly allocated copy destination, not libav's source buffer.
+   * Keep its offsets/strides but describe only the negotiated visible picture.
+   * A pool with an incompatible or undersized layout cannot be recovered by
+   * changing dimensions, so report a decoding error instead. */
+  {
+    GstVideoMeta *vmeta = gst_buffer_get_video_meta (frame->output_buffer);
+    if (vmeta && (vmeta->format != GST_VIDEO_INFO_FORMAT (info) ||
+            vmeta->width < (guint) GST_VIDEO_INFO_WIDTH (info) ||
+            vmeta->height < (guint) GST_VIDEO_INFO_HEIGHT (info))) {
+      GST_ELEMENT_ERROR (ffmpegdec, STREAM, DECODE,
+          ("Output buffer cannot hold the decoded picture"),
+          ("Video meta %ux%u, negotiated picture %dx%d",
+              vmeta->width, vmeta->height, GST_VIDEO_INFO_WIDTH (info),
+              GST_VIDEO_INFO_HEIGHT (info)));
+      return GST_FLOW_ERROR;
+    }
+    if (vmeta && (vmeta->width != (guint) GST_VIDEO_INFO_WIDTH (info) ||
+            vmeta->height != (guint) GST_VIDEO_INFO_HEIGHT (info))) {
+      frame->output_buffer = gst_buffer_make_writable (frame->output_buffer);
+      if (!frame->output_buffer)
+        return GST_FLOW_ERROR;
+      vmeta = gst_buffer_get_video_meta (frame->output_buffer);
+      if (!vmeta)
+        return GST_FLOW_ERROR;
+      vmeta->width = GST_VIDEO_INFO_WIDTH (info);
+      vmeta->height = GST_VIDEO_INFO_HEIGHT (info);
+    }
+  }
+
   /* original ffmpeg code does not handle odd sizes correctly.
