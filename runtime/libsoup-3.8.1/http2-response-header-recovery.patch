+/* Cancellation must wake the owner context even when the peer sends no
+ * response headers, rather than waiting for another socket-read event. */
+static gboolean
+response_wait_cancelled_cb (GCancellable *cancellable, SoupHTTP2MessageData *data)
+{
+        g_clear_pointer (&data->response_wait_cancel_source, g_source_unref);
+        if (data->task)
+                soup_http2_message_data_check_status_in_idle (data);
+        return G_SOURCE_REMOVE;
+}
+
+/* A reused HTTP/2 connection can stop answering individual streams while
+ * remaining pollable. Retry only a bodyless GET/HEAD with no response headers,
+ * once, and stop assigning new work to that connection. Active response bodies
+ * and non-replayable requests keep their existing connection and deadlines. */
+#define HEADERS_WAIT_TIMEOUT_US (20 * G_USEC_PER_SEC)
+#define HEADERS_RETRY_KEY "soup-http2-response-headers-retried"
+
+static void
+stop_headers_wait_source (SoupClientMessageIOHTTP2 *io)
+{
+        if (!io->headers_wait_source)
+                return;
+        g_source_destroy (io->headers_wait_source);
+        g_clear_pointer (&io->headers_wait_source, g_source_unref);
+}
+
+static gboolean
+headers_wait_source_cb (SoupClientMessageIOHTTP2 *io)
+{
+        SoupConnection *conn;
+        GHashTableIter iter;
+        SoupHTTP2MessageData *data;
+        gboolean keep_waiting = FALSE;
+        gint64 now = g_get_monotonic_time ();
+
+        conn = g_weak_ref_get (&io->conn);
+        if (!conn || io->is_shutdown || io->error) {
+                stop_headers_wait_source (io);
+                g_clear_object (&conn);
+                return G_SOURCE_REMOVE;
+        }
+        soup_connection_set_in_use (conn, TRUE);
+        g_hash_table_iter_init (&iter, io->messages);
+        while (g_hash_table_iter_next (&iter, NULL, (gpointer *)&data)) {
+                if (!data->headers_wait_started_us || !data->task ||
+                    data->error || data->state != STATE_WRITE_DONE)
+                        continue;
+                GCancellable *cancellable = g_task_get_cancellable (data->task);
+                if (cancellable && g_cancellable_is_cancelled (cancellable)) {
+                        data->headers_wait_started_us = 0;
+                        soup_http2_message_data_check_status_in_idle (data);
+                        continue;
+                }
+                if (data->paused) {
+                        data->headers_wait_started_us = now;
+                        keep_waiting = TRUE;
+                        continue;
+                }
+                /* Once this connection has stopped answering headers, do not
+                 * make younger eligible streams wait for their own deadline.
+                 * Completed responses and non-replayable requests are untouched. */
+                if (!io->headers_unresponsive &&
+                    now - data->headers_wait_started_us < HEADERS_WAIT_TIMEOUT_US) {
+                        keep_waiting = TRUE;
+                        continue;
+                }
+                data->headers_wait_started_us = 0;
+                io->headers_unresponsive = TRUE;
+                if (!g_object_get_data (G_OBJECT (data->msg), HEADERS_RETRY_KEY)) {
+                        g_object_set_data (G_OBJECT (data->msg), HEADERS_RETRY_KEY, GINT_TO_POINTER (1));
+                        /* Experimental per-message fallback. Not qualified until
+                         * a silent HTTP/1.1 replacement is also bounded. */
+                        soup_message_set_force_http_version (data->msg, SOUP_HTTP_1_1);
+                        data->can_be_restarted = TRUE;
+                        set_error_for_data (data, g_error_new_literal (G_IO_ERROR, G_IO_ERROR_CONNECTION_CLOSED,
+                                            "HTTP/2 response headers stalled; retrying with HTTP/1.1"));
+                        g_message ("HTTP/2 response-header guard: connection=%" G_GUINT64_FORMAT " stream=%u retry=1",
+                                   io->connection_id, data->stream_id);
+                } else {
+                        data->can_be_restarted = FALSE;
+                        set_error_for_data (data, g_error_new_literal (G_IO_ERROR, G_IO_ERROR_TIMED_OUT,
+                                            "HTTP/2 response headers stalled after one retry"));
+                        g_message ("HTTP/2 response-header guard: connection=%" G_GUINT64_FORMAT " stream=%u retry=0 exhausted=1",
+                                   io->connection_id, data->stream_id);
+                }
+                /* Defer completion: callbacks can remove other messages. */
+                soup_http2_message_data_check_status_in_idle (data);
+        }
+        if (!keep_waiting)
+                stop_headers_wait_source (io);
+        soup_connection_set_in_use (conn, FALSE);
+        g_object_unref (conn);
+        return keep_waiting ? G_SOURCE_CONTINUE : G_SOURCE_REMOVE;
+}
