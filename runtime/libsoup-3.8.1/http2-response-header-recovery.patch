+static void
+start_headers_wait (SoupHTTP2MessageData *data)
+{
+        SoupClientMessageIOHTTP2 *io = data->io;
+        const char *method = soup_message_get_method (data->msg);
+        if (!data->item->async ||
+            (method != SOUP_METHOD_GET && method != SOUP_METHOD_HEAD) ||
+            soup_message_get_request_body_stream (data->msg))
+                return;
+        data->headers_wait_started_us = g_get_monotonic_time ();
+        if (io->headers_wait_source)
+                return;
+        io->headers_wait_source = g_timeout_source_new (1000);
+        g_source_set_static_name (io->headers_wait_source, "Soup HTTP/2 response headers guard");
+        g_source_set_callback (io->headers_wait_source, (GSourceFunc)headers_wait_source_cb, io, NULL);
+        g_source_attach (io->headers_wait_source, g_main_context_get_thread_default ());
+}
