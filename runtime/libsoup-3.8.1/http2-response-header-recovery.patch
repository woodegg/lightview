+stop_fallback_budget (SoupMessageQueueItem *item)
+{
+        if (!item->fallback_budget_source)
+                return;
+        g_source_destroy (item->fallback_budget_source);
+        g_clear_pointer (&item->fallback_budget_source, g_source_unref);
+}
+
+void
+soup_message_queue_item_stop_header_fallback (SoupMessageQueueItem *item)
+{
+        stop_fallback_budget (item);
+        if (item->fallback_parent_cancel_source) {
+                g_source_destroy (item->fallback_parent_cancel_source);
+                g_clear_pointer (&item->fallback_parent_cancel_source, g_source_unref);
+        }
+
+}
+
+static gboolean
+fallback_parent_cancelled (GCancellable *parent, SoupMessageQueueItem *item)
+{
+        GCancellable *child = g_object_ref (item->cancellable);
+        soup_message_queue_item_ref (item);
+        g_cancellable_cancel (child);
+        /* Queued work has no socket source to wake when it is cancelled. */
+        soup_session_kick_queue (item->session);
+        g_object_unref (child);
+        soup_message_queue_item_unref (item);
+        return G_SOURCE_REMOVE;
+}
+
+static gboolean
+fallback_budget_expired (SoupMessageQueueItem *item)
+{
+        gint64 now = g_get_monotonic_time ();
+        gint64 elapsed = now - item->fallback_last_check_us;
+        item->fallback_last_check_us = now;
+        if (item->state == SOUP_MESSAGE_FINISHING || item->state == SOUP_MESSAGE_FINISHED ||
+            g_cancellable_is_cancelled (item->cancellable)) {
+                stop_fallback_budget (item);
+                return G_SOURCE_REMOVE;
+        }
+        /* Redirect/auth response bodies may be drained before this same send
+         * operation restarts. Preserve the remaining header budget across
+         * that restart without timing a body that is making progress. Normal
+         * final headers stop the source in async_send_request_return_result. */
+        if (item->paused || soup_message_get_status (item->msg) >= 200)
+                return G_SOURCE_CONTINUE;
+        item->fallback_remaining_us -= elapsed;
+        if (item->fallback_remaining_us > 0)
+                return G_SOURCE_CONTINUE;
+
+        /* The operation, including connection-pool and handshake waits, owns
+         * one budget. Only its private cancellable is cancelled. */
+        soup_message_queue_item_ref (item);
+        item->fallback_timed_out = TRUE;
+        stop_fallback_budget (item);
+        g_message ("HTTP/1.1 fallback budget expired: state=%d", item->state);
+        g_cancellable_cancel (item->cancellable);
+        soup_session_kick_queue (item->session);
+        soup_message_queue_item_unref (item);
+        return G_SOURCE_REMOVE;
+}
+
+void
+soup_message_queue_item_start_header_fallback (SoupMessageQueueItem *item)
+{
+        GCancellable *child;
+        if (!item->async || item->fallback_budget_source)
+                return;
+        child = g_cancellable_new ();
+        item->fallback_parent_cancel_source = g_cancellable_source_new (item->cancellable);
+        g_source_set_callback (item->fallback_parent_cancel_source,
+                               (GSourceFunc)fallback_parent_cancelled,
+                               item, NULL);
+        g_source_attach (item->fallback_parent_cancel_source, item->context);
+        g_object_unref (item->cancellable);
+        item->cancellable = child;
+        item->fallback_remaining_us = 20 * G_USEC_PER_SEC;
+        item->fallback_last_check_us = g_get_monotonic_time ();
+        item->fallback_budget_source = g_timeout_source_new (250);
+        g_source_set_static_name (item->fallback_budget_source, "Soup fallback response headers budget");
+        g_source_set_callback (item->fallback_budget_source,
+                               (GSourceFunc)fallback_budget_expired, item, NULL);
+        g_source_attach (item->fallback_budget_source, item->context);
+}
