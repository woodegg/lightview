#!/usr/bin/env python3
"""Small, dependency-free client for Lightview's local JSON control socket."""
import argparse
import json
import os
import socket
import sys
import time
from pathlib import Path


def default_socket():
    runtime = os.environ.get("XDG_RUNTIME_DIR")
    if not runtime:
        runtime = os.environ.get("XDG_CACHE_HOME", str(Path.home() / ".cache"))
    return str(Path(runtime) / "lightview" / "control.sock")


def request(socket_path, command, timeout=30, **fields):
    payload = json.dumps({"command": command, **fields}).encode() + b"\n"
    if len(payload) > 1024 * 1024:
        raise ValueError("Request exceeds 1 MiB")
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
        connection.settimeout(timeout)
        connection.connect(socket_path)
        connection.sendall(payload)
        with connection.makefile("rb") as stream:
            line = stream.readline(4 * 1024 * 1024 + 2)
    if not line.endswith(b"\n") or len(line) > 4 * 1024 * 1024 + 1:
        raise RuntimeError("Incomplete or oversized response from browser")
    response = json.loads(line)
    if not response.get("ok"):
        raise RuntimeError(response.get("error", "Browser request failed"))
    return response["result"]


def wait_for(path, expression, timeout, lease=None):
    deadline = time.monotonic() + timeout
    last_error = "condition is false"
    while time.monotonic() < deadline:
        remaining = max(0.01, deadline - time.monotonic())
        state = request(path, "status", remaining)
        if state.get("engine_state") == "suspended":
            request(path, "wake", remaining, lease=lease)
            continue
        if state.get("engine_state") == "failed":
            raise RuntimeError(state.get("load_error") or "WebKit recovery failed")
        if state.get("engine_state") != "ready":
            time.sleep(min(0.1, max(0, deadline - time.monotonic())))
            continue
        if state["load_error"]:
            raise RuntimeError(state["load_error"])
        try:
            if request(path, "eval", max(0.01, deadline - time.monotonic()),
                       script=f"Boolean({expression})", lease=lease):
                return True
        except RuntimeError as error:
            # A navigation may destroy the previous JavaScript context.
            last_error = str(error)
        time.sleep(min(0.1, max(0, deadline - time.monotonic())))
    raise TimeoutError(f"Wait timed out: {last_error}")


def wait_for_recovery(path, operation, timeout):
    deadline = time.monotonic() + timeout
    target = operation["target_generation"]
    while time.monotonic() < deadline:
        state = request(path, "status", max(0.01, deadline - time.monotonic()))
        if state["engine_state"] == "ready" and state["web_process_generation"] >= target:
            return {**operation, "engine_state": "ready",
                    "web_process_generation": state["web_process_generation"]}
        if state["engine_state"] == "failed":
            raise RuntimeError(state.get("load_error") or "WebKit recovery failed")
        time.sleep(min(0.1, max(0, deadline - time.monotonic())))
    raise TimeoutError("WebKit reset timed out")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--socket", default=default_socket(), help="browser control socket")
    parser.add_argument("--timeout", type=float, default=30, help="timeout in seconds")
    parser.add_argument("--lease", default=os.environ.get("LIGHTVIEW_LEASE"),
                        help="agent lease token (or set LIGHTVIEW_LEASE)")
    commands = parser.add_subparsers(dest="command", required=True)
    for name in ("status", "back", "forward", "reload", "stop", "quit"):
        commands.add_parser(name)
    commands.add_parser("wake", help="wake a hibernated WebKit engine")
    hibernate = commands.add_parser("hibernate-after",
        help="set idle seconds before WebKit hibernates; 0 disables it")
    hibernate.add_argument("seconds", type=int, metavar="SECONDS")
    lease = commands.add_parser("lease", help="reserve, renew, or release this browser")
    lease.add_argument("action", choices=("acquire", "renew", "release"))
    version = commands.add_parser("version", help="query the running engine versions")
    version.add_argument("--show", action="store_true", help="also activate the GTK version dialog")
    reset = commands.add_parser("reset", help="restart the replaceable WebKit engine")
    reset.add_argument("--hard", action="store_true", help="recreate the WebView and WebKit context")
    mode = commands.add_parser("mode", help="switch the running mode and rebuild WebKit")
    mode.add_argument("value", choices=("normal", "low-memory"))
    memory = commands.add_parser("memory-protection",
        help="enable, disable, or change the WebKit memory kill threshold")
    memory.add_argument("value", choices=("on", "off"))
    memory.add_argument("--threshold", type=int, metavar="MIB",
                        help="kill threshold to retain or apply")
    profile = commands.add_parser("profile",
        help="switch to a persistent profile folder and rebuild WebKit")
    profile.add_argument("path", metavar="DIR")
    open_parser = commands.add_parser("open")
    open_parser.add_argument("uri")
    open_parser.add_argument("--wait", action="store_true", help="wait for document load")
    js = commands.add_parser("eval", help="evaluate an expression; promises are awaited")
    js.add_argument("script", help="JavaScript expression, or - to read stdin")
    wait = commands.add_parser("wait", help="poll a JavaScript condition")
    wait.add_argument("expression", nargs="?", default="document.readyState === 'complete'")
    click = commands.add_parser("click", help="click the first CSS selector match")
    click.add_argument("selector")
    fill = commands.add_parser("fill", help="set a form field and emit input/change events")
    fill.add_argument("selector")
    fill.add_argument("text")
    args = parser.parse_args()
    if not 0 < args.timeout < float("inf"):
        parser.error("--timeout must be a finite positive number")
    try:
        command, fields = args.command, {}
        if args.lease:
            fields["lease"] = args.lease
        if command == "wait":
            result = wait_for(args.socket, args.expression, args.timeout, args.lease)
        else:
            if command == "open":
                fields["uri"] = args.uri
            elif command == "reset":
                fields["hard"] = args.hard
            elif command == "version":
                fields["show"] = args.show
            elif command == "mode":
                fields["low_memory"] = args.value == "low-memory"
            elif command == "memory-protection":
                fields["enabled"] = args.value == "on"
                if args.threshold is not None:
                    fields["kill_threshold_mib"] = args.threshold
            elif command == "profile":
                fields["path"] = args.path
            elif command == "lease":
                fields["action"] = args.action
            elif command == "hibernate-after":
                fields["seconds"] = args.seconds
            elif command == "eval":
                fields["script"] = sys.stdin.read() if args.script == "-" else args.script
            elif command in ("click", "fill"):
                selector = json.dumps(args.selector)
                action = "element.click();"
                if command == "fill":
                    action = f"""
                    const prototype = element instanceof HTMLTextAreaElement
                        ? HTMLTextAreaElement.prototype
                        : element instanceof HTMLSelectElement ? HTMLSelectElement.prototype
                        : HTMLInputElement.prototype;
                    const setter = Object.getOwnPropertyDescriptor(prototype, 'value').set;
                    setter.call(element, {json.dumps(args.text)});
                    element.dispatchEvent(new Event('input', {{bubbles: true}}));
                    element.dispatchEvent(new Event('change', {{bubbles: true}}));
                    """
                fields["script"] = f"""(() => {{
                    const element = document.querySelector({selector});
                    if (!element) throw new Error('No element matches selector');
                    element.focus();
                    {action}
                    return true;
                }})()"""
                command = "eval"
            result = request(args.socket, command, args.timeout, **fields)
            if args.command in ("reset", "mode", "memory-protection", "profile", "wake"):
                result = wait_for_recovery(args.socket, result, args.timeout)
            elif args.command == "open" and args.wait:
                result = wait_for(args.socket, "document.readyState === 'complete'",
                                  args.timeout, args.lease)
        print(json.dumps(result, ensure_ascii=False))
        return 0
    except (OSError, ValueError, RuntimeError) as error:
        print(f"lightviewctl: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
