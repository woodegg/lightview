#!/usr/bin/env python3
"""Report Linux process-tree RSS/PSS for a running browser, in MiB."""
import argparse
import json
from pathlib import Path


def measure(pid):
    parents = {}
    for entry in Path("/proc").iterdir():
        if entry.name.isdecimal():
            try:
                # comm may contain spaces and parentheses; fields after its last ')'.
                stat = (entry / "stat").read_text().rsplit(")", 1)[1].split()
                parents[int(entry.name)] = int(stat[1])
            except (OSError, IndexError, ValueError):
                continue
    if pid not in parents:
        raise SystemExit(f"Process {pid} does not exist or is not readable")
    selected = {pid}
    while True:
        descendants = {child for child, parent in parents.items() if parent in selected}
        if descendants <= selected:
            break
        selected |= descendants
    rows = []
    for child in sorted(selected):
        try:
            totals = {}
            for line in Path(f"/proc/{child}/smaps_rollup").read_text().splitlines():
                fields = line.split()
                if fields[0] in ("Rss:", "Pss:"):
                    totals[fields[0][:-1].lower() + "_mib"] = round(int(fields[1]) / 1024, 2)
            rows.append({"pid": child, "name": Path(f"/proc/{child}/comm").read_text().strip(), **totals})
        except OSError as error:
            rows.append({"pid": child, "error": str(error)})
    return {"processes": rows,
            "total_rss_mib": round(sum(row.get("rss_mib", 0) for row in rows), 2),
            "total_pss_mib": round(sum(row.get("pss_mib", 0) for row in rows), 2),
            "complete": all("pss_mib" in row for row in rows)}


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("pid", type=int, help="browser main PID, available from lightviewctl status")
    args = parser.parse_args()
    print(json.dumps(measure(args.pid), indent=2))
